{
  "mcpServers": {
    "tavily": {
      "command": "npx",
      "args": ["-y", "tavily-mcp@latest"],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY:-}"
      }
    },
    "gemini": {
      "command": "npx",
      "args": ["-y", "github:lawriec/mcp-gemini-media"],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY:-}"
      }
    },
    "yt-dl": {
      "command": "npx",
      "args": ["-y", "@kevinwatt/yt-dlp-mcp@latest"],
      "env": {
        "YTDLP_COOKIES_FROM_BROWSER": "${YTDLP_COOKIES_FROM_BROWSER:-}",
        "YTDLP_COOKIES_FILE": "${YTDLP_COOKIES_FILE:-}"
      }
    },
    "internet-archive": {
      "command": "npx",
      "args": ["-y", "github:lawriec/mcp-internet-archive"],
      "env": {}
    },
    "video-reader": {
      "command": "npx",
      "args": ["-y", "github:lawriec/mcp-video-reader"],
      "env": {}
    },
    "selenium": {
      "command": "npx",
      "args": ["-y", "@angiejones/mcp-selenium@latest"],
      "env": {}
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "env": {}
    },
    "memory-graph": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": {}
    },
    "common-crawl": {
      "command": "npx",
      "args": ["-y", "github:lawriec/mcp-common-crawl"],
      "env": {}
    },
    "reddit": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/adhikasp/mcp-reddit.git", "mcp-reddit"],
      "env": {
        "REDDIT_CLIENT_ID": "${REDDIT_CLIENT_ID:-}",
        "REDDIT_CLIENT_SECRET": "${REDDIT_CLIENT_SECRET:-}",
        "REDDIT_REFRESH_TOKEN": "${REDDIT_REFRESH_TOKEN:-}"
      }
    },
    "searxng": {
      "command": "npx",
      "args": ["-y", "github:lawriec/mcp-searxng"],
      "env": {
        "SEARXNG_URL": "${SEARXNG_URL:-http://localhost:8080}"
      }
    },
    "google-reverse-image": {
      "command": "npx",
      "args": ["-y", "github:lawriec/mcp-google-reverse-image"],
      "env": {
        "GOOGLE_VISION_API_KEY": "${GOOGLE_VISION_API_KEY:-}"
      }
    }
  }
}
